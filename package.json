{
  "name": "obsidian-github-synchronization",
  "version": "1.0.0-beta.5",
  "description": "Seamlessly synchronize your Obsidian notes with GitHub repositories. Keep your knowledge base versioned, backed up, and accessible across all your devices.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check:mobile": "node scripts/check-mobile.cjs",
    "check": "npm run build && npm run lint && npm test -- --runInBand && npm run check:mobile",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" scripts/*.cjs *.json *.mjs *.js README.md styles.css"
  },
  "keywords": [
    "obsidian",
    "github",
    "sync",
    "git",
    "version-control",
    "backup",
    "synchronization"
  ],
  "author": "Piotr Kierzniewski",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "esbuild": "0.17.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.1",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "diff3": "^0.0.3",
    "isomorphic-git": "^1.25.0",
    "minimatch": "^10.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
